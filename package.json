{
  "name": "portfolio-website",
  "version": "3.5.0",
  "private": true,
  "description": "Personal portfolio website showcasing my projects and skills. Built using React, React Router and TailwindCSS.",
  "keywords": [
    "Kirubakaran",
    "Visakan",
    "developer",
    "portfolio",
    "react",
    "react router",
    "software",
    "tailwindcss",
    "website"
  ],
  "homepage": "https://vikiru.vercel.app",
  "bugs": {
    "url": "https://github.com/vikiru/vikiru.github.io/issues"
  },
  "license": "MIT",
  "author": "Visakan Kirubakaran",
  "repository": {
    "type": "git",
    "url": "https://github.com/vikiru/vikiru.github.io"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "NODE_ENV=production vite build",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:legacy": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "lint:typecheck": "oxlint --type-aware --type-check --no-error-on-unmatched-pattern",
    "format": "oxfmt --write --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern",
    "unused": "knip",
    "check": "oxfmt --check && oxlint && tsc --noEmit",
    "generate-sitemap": "tsx src/scripts/generateSitemap.ts",
    "test:seo": "tsx --test src/lib/seo/schema.test.ts",
    "preview": "vite preview",
    "postinstall": "lefthook install"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/react-start": "^1.168.44",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "nitro": "3.0.1-alpha.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.8",
    "srvx": "^0.11.22",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "web-vitals": "^3.5.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "globals": "^16.5.0",
    "knip": "^5.88.1",
    "lefthook": "^2.1.10",
    "moment": "^2.30.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.79.0",
    "oxlint-tailwindcss": "^1.9.0",
    "react-scan": "^0.4.3",
    "schema-dts": "^1.1.5",
    "semantic-release": "^24.2.9",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "browserslist": {
    "production": [
      "defaults",
      ">0.01%",
      "not dead",
      "not op_mini all",
      "last 2 chrome version",
      "last 2 firefox version",
      "last 2 safari version"
    ],
    "development": [
      "defaults",
      ">0.01%",
      "not dead",
      "not op_mini all",
      "last 2 chrome version",
      "last 2 firefox version",
      "last 2 safari version"
    ]
  },
  "packageManager": "pnpm@11.22.0"
}
