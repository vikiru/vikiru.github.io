{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "oxc", "node", "react", "jsx-a11y", "typescript", "import", "unicorn", "promise", "react-perf"],
  "jsPlugins": ["oxlint-tailwindcss"],
  "settings": {
    "tailwindcss": {
      "entryPoint": "src/index.css"
    }
  },
  "options": {
    "typeAware": false,
    "typeCheck": false
  },
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/error-boundaries": "warn",
    "react/immutability": "warn",
    "react/purity": "warn",
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "react/set-state-in-render": "warn",
    "react/static-components": "warn",
    "react/use-memo": "warn",
    "tailwindcss/no-unknown-classes": "off",
    "tailwindcss/no-duplicate-classes": "error",
    "tailwindcss/no-conflicting-classes": "error",
    "tailwindcss/no-deprecated-classes": "error",
    "tailwindcss/enforce-canonical": "warn",
    "tailwindcss/enforce-sort-order": "off",
    "tailwindcss/enforce-shorthand": "off",
    "eqeqeq": "warn",
    "no-debugger": "error",
    "no-var": "error",
    "prefer-const": "warn",
    "no-duplicate-imports": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "warn",
    "no-unused-vars": "warn",
    "no-console": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "react/set-state-in-effect": "off",
    "import/no-unassigned-import": "off",
    "unicorn/no-instanceof-builtins": "off",
    "promise/always-return": "off"
  },
  "ignorePatterns": ["dist/**", ".output/**", ".vinxi/**", "node_modules/**", "**/routeTree.gen.ts"]
}
