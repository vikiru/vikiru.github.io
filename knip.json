{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "project": ["tsconfig.json"],
  "entry": ["src/router.tsx", "src/routes/**", "*.config.{js,mjs,cjs,ts}"],
  "ignore": ["src/setupTests.js"],
  "ignoreDependencies": [
    "@radix-ui/react-dialog",
    "lucide-react",
    "sonner",
    "srvx",
    "globals",
    "moment",
    "oxlint-tailwindcss",
    "react-scan"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": ["-lintignore"]
}
